rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','alias','bio','updatedAt'])
        && request.resource.data.alias is string && request.resource.data.alias.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 500;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.keys().hasOnly(['ownerId','title','price','details','level','imageUrl','status','createdAt']);
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /purchases/{purchaseId} {
      allow read: if signedIn() &&
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      // Purchases must be created/updated by trusted server code after payment verification.
      allow write: if false;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && exists(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId))
        && get(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/purchases/$(request.resource.data.purchaseId)).data.status == 'completed';
      allow update, delete: if false;
    }
  }
}